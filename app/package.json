{
  "name": "pisotab-desktop",
  "version": "0.6.0",
  "description": "PisoTab standalone Windows desktop dashboard",
  "main": "main.js",
  "author": "PisoTab",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win portable"
  },
  "devDependencies": {
    "electron": "^38.2.0",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "com.pisotab.desktop",
    "productName": "PisoTab Dashboard",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../runtime/node.exe",
        "to": "pisotab-runtime/node.exe"
      },
      {
        "from": "../bundle-server",
        "to": "pisotab-server/server",
        "filter": [
          "**/*",
          "!**/.cache/**"
        ]
      },
      {
        "from": "../dashboard",
        "to": "pisotab-server/dashboard",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "PisoTab-Portable-${version}.exe"
    }
  }
}
